# === API Keys ===
SHODAN_API_KEY=your_shodan_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# === Service Toggles ===
# Set to false to disable a data source entirely
SHODAN_ENABLED=false
VIRUSTOTAL_ENABLED=true
CRT_ENABLED=true
WHOIS_ENABLED=true
DNS_ENABLED=true

# === Rate Limits (requests/min) ===
SHODAN_RATE_LIMIT=1
VIRUSTOTAL_RATE_LIMIT=4
CRT_RATE_LIMIT=10
WHOIS_RATE_LIMIT=5
DNS_RATE_LIMIT=20

# === Recursion ===
MAX_RECURSION_DEPTH=2

# === Data Retention ===
RETENTION_DAYS=90

# === Backup ===
BACKUP_DIR=/ai-bunker/osint-dashboard/backups

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === Database ===
DATABASE_URL=sqlite:///./data/osint.db

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
